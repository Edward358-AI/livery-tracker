# Command bot token from @BotFather
BOT_TOKEN=123456789:AA...your-token-here

# Your personal Telegram chat id (the setup wizard fills this in automatically)
CHAT_ID=123456789

# SECOND bot (also from @BotFather) that owns the once-a-day flight digest
# message, keeping the command bot's chat completely clean. Required.
DIGEST_BOT_TOKEN=123456789:BB...second-bot-token

# Optional: override where runtime JSON/state lives (default: ./data)
# LT_DATA_DIR=/path/to/data

# Optional: local time for the daily schedule harvest, 24h HH:MM (default: 06:00)
# HARVEST_TIME=06:00
